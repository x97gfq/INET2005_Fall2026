# Copy this file to .env and fill in real values.
# .env itself is gitignored — .env.example is the only one that gets committed,
# so teammates know which variables exist without seeing anyone's real secrets.

DB_HOST=db
DB_PORT=3306
DB_NAME=appdb
DB_USER=appuser
DB_PASS=apppassword

WEATHER_API_KEY=demo_key_12345
