# Copy to .env in this folder and fill in ONE provider. Never commit .env (it's git-ignored).
#   docker compose exec node cp week10/class1/00_trivia_start/.env.example week10/class1/00_trivia_start/.env
# Any OpenAI-compatible provider works: only these three lines change. More in the assignment.

# Groq (free tier: console.groq.com)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your-key-here
AI_MODEL=llama-3.1-8b-instant

# Augure (Canadian; apply for access first): https://augureai.ca/developers
# AI_BASE_URL=https://api.augureai.ca/v1
# AI_MODEL=tofino-3

# Google Gemini (free key: aistudio.google.com)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash

# No key yet? A fake provider that answers instantly. Start it in another terminal first:
#   docker compose exec node node week10/class1/fake-ai/fake-ai.js
# AI_BASE_URL=http://localhost:3003/v1
# AI_API_KEY=anything
# AI_MODEL=fake
