# mflix-bff settings. Copy this file to .env (same folder) and fill it in:
#   docker compose exec node cp week10/mflix-bff/.env.example week10/mflix-bff/.env
# .env is git-ignored. The KEY never goes to GitHub, and never into the React app.

# Signs the session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Week 11 (the AI route). Any OpenAI-compatible Chat Completions provider: only these three lines change.
# Augure (Canadian; the class demo). Models and prices: https://augureai.ca/developers
AI_BASE_URL=https://api.augureai.ca/v1
AI_API_KEY=your-key-here
AI_MODEL=tofino-3

# The trivia assignment's providers work too, e.g. Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant

# No key yet? A fake AI that answers instantly. Start it in another terminal first:
#   docker compose exec node node week10/class1/fake-ai/fake-ai.js
# AI_BASE_URL=http://localhost:3003/v1
# AI_API_KEY=anything
# AI_MODEL=fake

# Optional: where the movies API is (the default works inside the node container)
# MOVIES_API=http://localhost:3002/api
