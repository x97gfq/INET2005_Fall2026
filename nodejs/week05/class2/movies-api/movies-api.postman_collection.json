{
  "info": {
    "name": "INET2005 Week 5 - Movies API",
    "description": "Express + Mongoose over sample_mflix.movies. Start movies-api first (port 3001). Run the folders top to bottom: Create saves the new _id in the movieId collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "matrix",
      "value": "573a139bf29313caabcf3d23"
    },
    {
      "key": "movieId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Read",
      "item": [
        {
          "name": "Search by title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?title=matrix",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ],
              "query": [
                {
                  "key": "title",
                  "value": "matrix"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by genre and year",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?genre=Sci-Fi&year=1999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ],
              "query": [
                {
                  "key": "genre",
                  "value": "Sci-Fi"
                },
                {
                  "key": "year",
                  "value": "1999"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Page 3, 5 per page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?genre=Western&page=3&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ],
              "query": [
                {
                  "key": "genre",
                  "value": "Western"
                },
                {
                  "key": "page",
                  "value": "3"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('page 3', () => pm.expect(pm.response.json().page).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "One movie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{matrix}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{matrix}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Create, update, delete",
      "item": [
        {
          "name": "Create a movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"INET2005: The Movie\",\n  \"year\": 2026,\n  \"runtime\": 95,\n  \"genres\": [\n    \"Documentary\",\n    \"Comedy\"\n  ],\n  \"rated\": \"PG\",\n  \"plot\": \"Students build an API in an afternoon.\",\n  \"directors\": [\n    \"A. Student\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('movieId', pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read it back",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH some fields",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rated\": \"PG-13\",\n  \"runtime\": 102\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT (replace)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"INET2005: The Director's Cut\",\n  \"year\": 2027\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('plot is gone', () => pm.expect(pm.response.json().plot).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete it",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Gone (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "{{movieId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Should fail",
      "item": [
        {
          "name": "400 - breaks the schema",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 1066\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "400 - not an ObjectId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/banana",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "banana"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 - no such movie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/000000000000000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "000000000000000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
