# Copy this file to .env (same folder) and fill in your own values:
#   docker compose exec node cp week05/class1/.env.example week05/class1/.env
# .env is in .gitignore and must never be committed. This file has no secrets, so it is.

# Running inside Docker (docker compose exec node node ...):
#   "localhost" would mean the node container itself, so use the service name.
DB_HOST=db
DB_PORT=3306

# Running Node on Windows instead (cd nodejs, then node week05/...):
#   use the port Docker publishes on your machine.
# DB_HOST=localhost
# DB_PORT=13306

DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=appdb

# Port for the web server (Docker publishes 3001)
PORT=3001
