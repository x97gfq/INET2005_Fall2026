<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>
<body>
    <nav class="navbar bg-dark" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand" href="/">Movies</a>
            <%# TODO Part 7: username + Log out button when logged in, otherwise Log in + Register links %>
            <% if (username) { %>
                <form method="POST" action="/logout" class="d-flex align-items-center gap-3">
                    <span class="navbar-text"><%= username %></span>
                    <button class="btn btn-sm btn-outline-light">Log out</button>
                </form>
            <% } else { %>
                <div class="d-flex gap-3">
                    <a class="nav-link" href="/login">Log in</a>
                    <a class="nav-link" href="/register">Register</a>
                </div>
            <% } %>
        </div>
    </nav>
    <div class="container my-4">
