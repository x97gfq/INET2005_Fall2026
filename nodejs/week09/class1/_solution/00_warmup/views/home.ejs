<%- include('partials/header', { title: 'Movies from 1999' }) %>

<h1 class="mb-3">Movies from 1999</h1>
<table class="table table-striped">
  <tr><th>Title</th><th>IMDb</th></tr>
  <% movies.forEach((movie) => { %>
    <tr>
      <td><%= movie.title %></td>
      <td><%= movie.imdb.rating %></td>
    </tr>
  <% }); %>
</table>

<%- include('partials/footer') %>
