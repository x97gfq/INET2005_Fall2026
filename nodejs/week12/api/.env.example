# The API's settings. Copy to .env (git-ignored) and change what you need:
#   docker compose exec node cp week12/api/.env.example week12/api/.env
# In our container, MONGO_URL is already set by docker-compose.yml, and that value wins.
PORT=3001
MONGO_URL=mongodb://localhost:27017
DB_NAME=sample_mflix

# Class 1: the secret that signs every login token. Make your own (64 random hex characters):
#   docker compose exec node node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then paste it after the = sign. Never commit it: anyone who has it can make a token for anyone.
JWT_SECRET=
