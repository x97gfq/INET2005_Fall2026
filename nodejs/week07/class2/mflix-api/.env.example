# Copy to .env and fill in. .env is git-ignored; this file is the template you commit.
# Inside Docker, MONGO_URL is already set by docker-compose.yml (mongodb://mongo:27017)
# and wins over this file.
PORT=3001
DB_NAME=sample_mflix

# The key that signs every token. Long and random, and different on every machine.
# Make one:  docker compose exec node node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Left empty in class, the server uses a dev secret and logs a warning.
# With NODE_ENV=production it refuses to start without one.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Failed logins allowed per username + IP, per 15 minutes, before 429
LOGIN_MAX_ATTEMPTS=5

# error | warn | info | http | verbose | debug
LOG_LEVEL=http
# NODE_ENV=production

# Running Node on Windows instead of in Docker:
# MONGO_URL=mongodb://localhost:27017
