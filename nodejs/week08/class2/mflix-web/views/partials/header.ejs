<%# The top of every page. user, flash and csrfToken come from res.locals (middleware/pages.js),
    so no route has to pass them. locals.user rather than user: the error page can be
    rendered before that middleware ran, and a missing variable would crash the template. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · mflix</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand bg-dark" data-bs-theme="dark">
    <div class="container">
      <a class="navbar-brand" href="/movies">mflix</a>
      <div class="navbar-nav me-auto">
        <a class="nav-link" href="/movies">Movies</a>
        <% if (locals.canEdit) { %><a class="nav-link" href="/movies/new">Add a movie</a><% } %>
        <a class="nav-link" href="/api-docs">API</a>
      </div>
      <% if (locals.user) { %>
        <span class="navbar-text me-3"><%= user.username %> <span class="badge text-bg-secondary"><%= user.role %></span></span>
        <form method="POST" action="/logout" class="d-flex">
          <%- include('csrf') %>
          <button class="btn btn-sm btn-outline-light">Log out</button>
        </form>
      <% } else { %>
        <a class="btn btn-sm btn-outline-light" href="/login">Log in</a>
      <% } %>
    </div>
  </nav>
  <main class="container my-4">
    <% if (locals.flash) { %>
      <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
    <% } %>
