<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <h1 class="h3 mb-4">Log in</h1>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <%- include('partials/csrf') %>
      <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <%# Keep the username after a failed try - never the password %>
        <input class="form-control" id="username" name="username" value="<%= username %>" autocomplete="username">
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input type="password" class="form-control" id="password" name="password" autocomplete="current-password">
      </div>
      <button class="btn btn-primary">Log in</button>
    </form>

    <table class="table table-sm small mt-4">
      <tr><th>User</th><th>Password</th><th>Can</th></tr>
      <tr><td><code>alice</code></td><td><code>password123</code></td><td>admin: add, edit, delete</td></tr>
      <tr><td><code>bob</code></td><td><code>letmein</code></td><td>editor: add, edit</td></tr>
      <tr><td><code>carol</code></td><td><code>hunter2</code></td><td>viewer: read only</td></tr>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
