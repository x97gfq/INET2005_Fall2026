        {
          "name": "Security headers on every response",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?limit=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ],
