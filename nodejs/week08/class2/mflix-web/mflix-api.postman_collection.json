{
  "info": {
    "name": "INET2005 Week 7 - Movies API (validation, logging, JWT)",
    "description": "The week 6 movies API with validation middleware, morgan + winston logging and JWT auth.\n\nStart week08/class2/mflix-web/server.js (or week07/class2/mflix-api/server.js) first (port 3001). Run the folders top to bottom: the Login requests save each user's token in a collection variable (token_alice, token_bob, token_carol) and Create saves the new movie's _id in movieId.\n\nalice / password123 (admin) - bob / letmein (editor) - carol / hunter2 (viewer)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "matrix",
      "value": "573a139bf29313caabcf3d23"
    },
    {
      "key": "token_alice",
      "value": ""
    },
    {
      "key": "token_bob",
      "value": ""
    },
    {
      "key": "token_carol",
      "value": ""
    },
    {
      "key": "token_logout",
      "value": ""
    },
    {
      "key": "movieId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Reading is public",
      "item": [
        {
          "name": "Search by title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?title=matrix",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies"
              ],
              "query": [
                {
                  "key": "title",
                  "value": "matrix"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('finds The Matrix', () => pm.expect(pm.response.json().results.map(m => m.title)).to.include('The Matrix'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter + pagination",
          "request": {
