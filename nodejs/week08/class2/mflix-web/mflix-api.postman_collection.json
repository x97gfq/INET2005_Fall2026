          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Security-Policy', () => pm.response.to.have.header('Content-Security-Policy'));",
                  "pm.test('nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
                  "pm.test('no framing', () => pm.response.to.have.header('X-Frame-Options'));",
                  "pm.test('no X-Powered-By', () => pm.response.to.not.have.header('X-Powered-By'));"
                ]
              }
            }
          ]
        }
