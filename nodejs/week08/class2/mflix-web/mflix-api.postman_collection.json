    {
      "name": "7. Rate limiting the login",
      "item": [
        {
          "name": "429 - sixth failed login for eve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"eve\",\n  \"password\": \"guess\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Five failed logins first (eve isn't a real user, so no one real is locked out).",
                  "// Re-running inside 15 minutes is fine: these just get 429 too.",
                  "for (let i = 0; i < 5; i++) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/auth/login', method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ username: 'eve', password: 'guess' }) },",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 429', () => pm.response.to.have.status(429));",
                  "pm.test('has a RateLimit header', () => pm.response.to.have.header('RateLimit'));",
                  "pm.test('has Retry-After', () => pm.response.to.have.header('Retry-After'));"
                ]
              }
            }
          ]
        }
      ]
    },
