<%- include('partials/header') %>

<h1 class="h3 mb-3">Movies</h1>

<form method="GET" action="/movies" class="row g-2 mb-4">
  <div class="col-sm-9"><input name="title" class="form-control" placeholder="Search a title" value="<%= search %>"></div>
  <div class="col-sm-3 d-grid"><button class="btn btn-primary">Search</button></div>
</form>

<% if (movies.length === 0) { %>
  <div class="alert alert-warning">No movies match "<%= search %>".</div>
<% } else { %>
  <table class="table table-striped">
    <thead><tr><th>Title</th><th>Year</th><th>Genres</th><th>IMDb</th></tr></thead>
    <tbody>
      <% movies.forEach((m) => { %>
        <%- include('partials/movie-row', { m }) %>
      <% }); %>
    </tbody>
  </table>

  <%# LEVEL 1: paging %>
  <div class="d-flex justify-content-between align-items-center">
    <span class="text-muted"><%= total.toLocaleString() %> movies · page <%= page %> of <%= totalPages %></span>
    <div class="btn-group">
      <a class="btn btn-outline-secondary <%= page <= 1 ? 'disabled' : '' %>" href="<%= pageUrl(page - 1) %>">&larr; Previous</a>
      <a class="btn btn-outline-secondary <%= page >= totalPages ? 'disabled' : '' %>" href="<%= pageUrl(page + 1) %>">Next &rarr;</a>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
