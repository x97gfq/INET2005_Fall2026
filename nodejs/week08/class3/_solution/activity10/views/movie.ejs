<%- include('partials/header') %>

<a href="/movies" class="btn btn-sm btn-outline-secondary mb-3">&larr; All movies</a>

<h1><%= movie.title %> <small class="text-muted"><%= movie.year %></small></h1>
<p><%= (movie.genres || []).join(', ') %></p>
<% if (movie.plot) { %><p class="lead"><%= movie.plot %></p><% } %>
<p>IMDb <strong><%= movie.imdb && movie.imdb.rating ? movie.imdb.rating : 'N/A' %></strong></p>

<%# LEVEL 1: the comments %>
<h2 class="h4 mt-4" id="comments">Comments (<%= commentCount %>)</h2>
<% if (comments.length === 0) { %>
  <p class="text-muted">No comments yet. Be the first.</p>
<% } else { %>
  <% if (commentCount > comments.length) { %>
    <p class="small text-muted">Showing the newest <%= comments.length %>.</p>
  <% } %>
  <ul class="list-group mb-4">
    <% comments.forEach((c) => { %>
      <li class="list-group-item">
        <strong><%= c.name %></strong>
        <small class="text-muted"><%= c.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric' }) %></small>
        <p class="mb-0"><%= c.text %></p>
      </li>
    <% }); %>
  </ul>
<% } %>

<%# LEVEL 3: add a comment %>
<h3 class="h5">Add a comment</h3>
<form method="POST" action="/movies/<%= movie._id %>/comments" class="mb-4">
  <div class="mb-2">
    <input name="name" class="form-control <%= errors.name ? 'is-invalid' : '' %>" placeholder="Your name" value="<%= form.name || '' %>">
    <div class="invalid-feedback"><%= errors.name %></div>
  </div>
  <div class="mb-2">
    <textarea name="text" rows="3" class="form-control <%= errors.text ? 'is-invalid' : '' %>" placeholder="What did you think?"><%= form.text || '' %></textarea>
    <div class="invalid-feedback"><%= errors.text %></div>
  </div>
  <button class="btn btn-primary">Post</button>
</form>

<%- include('partials/footer') %>
